generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  username             String              @unique
  passwordHash         String
  isGuest              Boolean             @default(false)
  xp                   Int                 @default(0)
  streak               Int                 @default(0)
  lastActiveAt         DateTime?
  createdAt            DateTime            @default(now())
  plan                 Plan                @default(FREE)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  aiUsage              AiMessageUsage[]
  badgesUnlocked       BadgesOnUsers[]
  configBuilds         ConfigBuild[]
  diagnosticAttempts   DiagnosticAttempt[]
  examAttempts         ExamAttempt[]
  interviewAttempts    InterviewAttempt[]
  progress             LessonProgress[]
  pageViews            PageView[]
  quizAttempts         QuizAttempt[]
  reviews              Review[]
  reviewCards          ReviewCard[]
  sessions             Session[]
}

model AiMessageUsage {
  id        String   @id @default(cuid())
  userId    String
  monthKey  String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@index([userId, monthKey])
}

model Session {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Track {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  level       String
  description String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id           String           @id @default(cuid())
  slug         String           @unique
  trackId      String
  title        String
  level        String
  durationMin  Int
  order        Int
  objective    String
  simple       String
  technical    String
  examples     String
  mistakes     String
  keyTakeaways String
  diagram      String?
  track        Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Int      @default(0)
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizQuestion {
  id          String @id @default(cuid())
  category    String
  difficulty  String
  type        String
  prompt      String
  choices     String
  answer      String
  explanation String
  xpReward    Int    @default(10)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  mode      String
  category  String?
  score     Int
  total     Int
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exam {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  level       String
  durationSec Int
  questionIds String
}

model ExamAttempt {
  id           String   @id @default(cuid())
  userId       String
  examId       String
  score        Int
  total        Int
  timeSpentSec Int
  details      String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewAttempt {
  id         String   @id @default(cuid())
  userId     String
  role       String
  level      String
  score      Int
  feedback   String
  transcript String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiagnosticScenario {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  symptoms   String
  steps      String
  category   String
  difficulty String
}

model DiagnosticAttempt {
  id          String   @id @default(cuid())
  userId      String
  scenarioId  String
  stepsChosen String
  score       Int
  evaluation  String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Component {
  id       String  @id @default(cuid())
  type     String
  brand    String
  model    String
  price    Int
  specs    String
  category String?
}

model ConfigBuild {
  id          String   @id @default(cuid())
  userId      String
  name        String
  components  String
  constraints String?
  score       Int?
  feedback    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlossaryTerm {
  id         String  @id @default(cuid())
  slug       String  @unique
  term       String
  simple     String
  technical  String
  example    String?
  level      String
  categories String
}

model ReviewCard {
  id       String   @id @default(cuid())
  userId   String
  termSlug String
  ease     Float    @default(2.5)
  interval Int      @default(1)
  dueAt    DateTime @default(now())
  reps     Int      @default(0)
  lapses   Int      @default(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termSlug])
}

model Badge {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  icon        String
  unlockedBy  BadgesOnUsers[]
}

model BadgesOnUsers {
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  url       String
  visitorId String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([url])
  @@index([visitorId])
}

enum Plan {
  FREE
  ESSENTIEL
  PRO
  ULTIMATE
}
